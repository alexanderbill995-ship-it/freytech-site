# Frey Technologies — static site (Next.js export) on Apache / LiteSpeed (Hostinger)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

RewriteEngine On

# HTTPS everywhere, and www -> bare domain (canonical is https://freytech.org)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://freytech.org%{REQUEST_URI} [L,R=301]

# Legacy Joomla query-string URLs (old freytech.org)
RewriteCond %{QUERY_STRING} option=com_content.*id=20 [NC]
RewriteRule ^index\.php$ /resources/total-alkalinity-and-controllers/? [L,R=301]
RewriteCond %{QUERY_STRING} option=com_content.*id=(1)$ [NC]
RewriteRule ^index\.php$ /? [L,R=301]
RewriteCond %{QUERY_STRING} option=com_content.*id=(2|14) [NC]
RewriteRule ^index\.php$ /projects/? [L,R=301]
RewriteCond %{QUERY_STRING} option=com_content.*id=(4|13) [NC]
RewriteRule ^index\.php$ /about/? [L,R=301]
RewriteCond %{QUERY_STRING} option=com_content.*id=(8|9) [NC]
RewriteRule ^index\.php$ /service-support/? [L,R=301]
RewriteCond %{QUERY_STRING} option=com_content.*id=10 [NC]
RewriteRule ^index\.php$ /contact/? [L,R=301]
RewriteCond %{QUERY_STRING} option=com_content [NC]
RewriteRule ^index\.php$ /resources/? [L,R=301]
RewriteRule ^index\.php$ / [L,R=301]

# Legacy Joomla paths
RedirectMatch 301 ^/about/what-we-do/?$ /about/
RedirectMatch 301 ^/about/who-we-work-with/?$ /projects/
RedirectMatch 301 ^/about/history-leadership/?$ /about/
RedirectMatch 301 ^/about/news/20-have-you-checked-your-alkalinity-today/?$ /resources/total-alkalinity-and-controllers/
RedirectMatch 301 ^/about/news/?$ /resources/
RedirectMatch 301 ^/about/resources/?$ /resources/
RewriteRule ^service-and-support/warranties/?$ /service-support/#warranty [L,R=301,NE]
RedirectMatch 301 ^/service-and-support/request-a-quote/?$ /contact/
RedirectMatch 301 ^/service-and-support(/.*)?$ /service-support/
RedirectMatch 301 ^/project-showcase(/.*)?$ /projects/
RedirectMatch 301 ^/contact-us/?$ /contact/
RedirectMatch 301 ^/products/deck-accessibility-safety/(.*)$ /products/deck-equipment/$1
RedirectMatch 301 ^/images/logo\.png$ /images/brand/freytech-logo.png
RedirectMatch 301 ^/images/slider2\.jpg$ /images/projects/ithaca-college-50m-pool.webp
RedirectMatch 301 ^/images/UofR\.jpg$ /images/projects/university-of-rochester-natatorium.webp
RedirectMatch 301 ^/images/Fairport\.jpg$ /images/projects/fairport-high-school-pool.webp
RedirectMatch 410 ^/(component|administrator)(/.*)?$

# Caching: hashed Next.js assets are immutable; HTML revalidates
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
AddType image/webp .webp
AddType font/woff2 .woff2
